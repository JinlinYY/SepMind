{
  "$defs": {
    "Column": {
      "additionalProperties": false,
      "properties": {
        "reflux_ratio": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reflux Ratio"
        },
        "reflux_multiplier": {
          "anyOf": [
            {
              "exclusiveMinimum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reflux Multiplier"
        },
        "max_stages": {
          "default": 200,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Stages",
          "type": "integer"
        }
      },
      "title": "Column",
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "properties": {
        "canonical_id": {
          "title": "Canonical Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "cas": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cas"
        }
      },
      "required": [
        "canonical_id",
        "name"
      ],
      "title": "Component",
      "type": "object"
    },
    "DesignBasis": {
      "additionalProperties": false,
      "properties": {
        "design_id": {
          "title": "Design Id",
          "type": "string"
        },
        "process_goal": {
          "default": "preliminary_binary_distillation",
          "title": "Process Goal",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "title": "Components",
          "type": "array"
        },
        "feed": {
          "$ref": "#/$defs/Feed"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "design_level": {
          "default": "preliminary_process",
          "enum": [
            "feasibility",
            "preliminary_process",
            "preliminary_equipment"
          ],
          "title": "Design Level",
          "type": "string"
        },
        "design_mode": {
          "default": "autonomous",
          "enum": [
            "autonomous",
            "specified"
          ],
          "title": "Design Mode",
          "type": "string"
        },
        "origin_tags": {
          "additionalProperties": {
            "enum": [
              "provided",
              "source_reported",
              "retrieved_verified",
              "calculated",
              "estimated",
              "assumed",
              "unresolved"
            ],
            "type": "string"
          },
          "title": "Origin Tags",
          "type": "object"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "thermodynamic_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thermodynamic Model"
        },
        "column": {
          "$ref": "#/$defs/Column"
        },
        "equipment": {
          "anyOf": [
            {
              "$ref": "#/$defs/EquipmentBasis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "DesignBasis",
      "type": "object"
    },
    "EquipmentBasis": {
      "additionalProperties": false,
      "description": "Explicit preliminary design assumptions, not measured/vendor properties.\n\nValues below are a transparent teaching policy when the Agent proposes them.\nNative transport and water/steam properties are calculated, not supplied here.",
      "properties": {
        "tray_spacing_m": {
          "default": 0.45,
          "maximum": 1.0,
          "minimum": 0.3,
          "title": "Tray Spacing M",
          "type": "number"
        },
        "tray_type": {
          "default": "F1_valve",
          "enum": [
            "sieve",
            "F1_valve"
          ],
          "title": "Tray Type",
          "type": "string"
        },
        "f1": {
          "$ref": "#/$defs/F1ValveBasis"
        },
        "pump": {
          "$ref": "#/$defs/PumpBasis"
        },
        "weir_height_m": {
          "default": 0.05,
          "exclusiveMinimum": 0.0,
          "maximum": 0.1,
          "title": "Weir Height M",
          "type": "number"
        },
        "downcomer_area_fraction": {
          "default": 0.12,
          "maximum": 0.2,
          "minimum": 0.08,
          "title": "Downcomer Area Fraction",
          "type": "number"
        },
        "hole_area_fraction": {
          "default": 0.1,
          "maximum": 0.15,
          "minimum": 0.05,
          "title": "Hole Area Fraction",
          "type": "number"
        },
        "hole_diameter_mm": {
          "default": 5.0,
          "maximum": 20.0,
          "minimum": 3.0,
          "title": "Hole Diameter Mm",
          "type": "number"
        },
        "weeping_coefficient": {
          "anyOf": [
            {
              "$ref": "#/$defs/WeepingCoefficient"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "minimum_load_fraction": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Load Fraction"
        },
        "weir_length_diameter_ratio": {
          "default": 0.7,
          "maximum": 0.8,
          "minimum": 0.5,
          "title": "Weir Length Diameter Ratio",
          "type": "number"
        },
        "downcomer_clearance_m": {
          "default": 0.04,
          "exclusiveMinimum": 0.0,
          "maximum": 0.1,
          "title": "Downcomer Clearance M",
          "type": "number"
        },
        "orifice_coefficient": {
          "default": 0.65,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.3,
          "title": "Orifice Coefficient",
          "type": "number"
        },
        "max_flood_fraction": {
          "default": 0.7,
          "maximum": 0.8,
          "minimum": 0.4,
          "title": "Max Flood Fraction",
          "type": "number"
        },
        "top_disengagement_m": {
          "default": 1.5,
          "exclusiveMinimum": 0.0,
          "title": "Top Disengagement M",
          "type": "number"
        },
        "bottom_sump_m": {
          "default": 3.0,
          "exclusiveMinimum": 0.0,
          "title": "Bottom Sump M",
          "type": "number"
        },
        "cooling_inlet_K": {
          "default": 298.15,
          "exclusiveMaximum": 370.0,
          "minimum": 273.16,
          "title": "Cooling Inlet K",
          "type": "number"
        },
        "cooling_outlet_K": {
          "default": 308.15,
          "exclusiveMaximum": 370.0,
          "exclusiveMinimum": 273.16,
          "title": "Cooling Outlet K",
          "type": "number"
        },
        "steam_pressure_Pa": {
          "default": 400000.0,
          "maximum": 10000000.0,
          "minimum": 100000.0,
          "title": "Steam Pressure Pa",
          "type": "number"
        },
        "condenser_U_W_m2_K": {
          "default": 500.0,
          "exclusiveMinimum": 0.0,
          "title": "Condenser U W M2 K",
          "type": "number"
        },
        "reboiler_U_W_m2_K": {
          "default": 1000.0,
          "exclusiveMinimum": 0.0,
          "title": "Reboiler U W M2 K",
          "type": "number"
        },
        "minimum_approach_K": {
          "default": 10.0,
          "exclusiveMinimum": 0.0,
          "title": "Minimum Approach K",
          "type": "number"
        },
        "area_margin": {
          "default": 1.15,
          "maximum": 2.0,
          "minimum": 1.0,
          "title": "Area Margin",
          "type": "number"
        },
        "liquid_nozzle_velocity_m_s": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 5.0,
          "title": "Liquid Nozzle Velocity M S",
          "type": "number"
        },
        "vapor_nozzle_velocity_m_s": {
          "default": 20.0,
          "exclusiveMinimum": 0.0,
          "maximum": 50.0,
          "title": "Vapor Nozzle Velocity M S",
          "type": "number"
        },
        "pump_total_head_m": {
          "default": 30.0,
          "exclusiveMinimum": 0.0,
          "title": "Pump Total Head M",
          "type": "number"
        },
        "pump_efficiency": {
          "default": 0.65,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Pump Efficiency",
          "type": "number"
        },
        "motor_margin": {
          "default": 1.2,
          "maximum": 2.0,
          "minimum": 1.0,
          "title": "Motor Margin",
          "type": "number"
        },
        "assumption_origin": {
          "default": "agent_proposed_estimate",
          "enum": [
            "agent_proposed_estimate",
            "user_provided"
          ],
          "title": "Assumption Origin",
          "type": "string"
        }
      },
      "title": "EquipmentBasis",
      "type": "object"
    },
    "ExtractionSearch": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "default": "countercurrent",
          "enum": [
            "countercurrent",
            "crosscurrent"
          ],
          "title": "Configuration",
          "type": "string"
        },
        "stage_candidates": {
          "items": {
            "type": "integer"
          },
          "title": "Stage Candidates",
          "type": "array"
        },
        "solvent_feed_mass_ratios": {
          "items": {
            "type": "number"
          },
          "title": "Solvent Feed Mass Ratios",
          "type": "array"
        },
        "maximum_candidates": {
          "default": 9,
          "maximum": 36,
          "minimum": 1,
          "title": "Maximum Candidates",
          "type": "integer"
        },
        "max_iterations": {
          "default": 160,
          "maximum": 300,
          "minimum": 5,
          "title": "Max Iterations",
          "type": "integer"
        }
      },
      "title": "ExtractionSearch",
      "type": "object"
    },
    "F1ValveBasis": {
      "additionalProperties": false,
      "properties": {
        "hole_diameter_m": {
          "default": 0.039,
          "exclusiveMinimum": 0.0,
          "title": "Hole Diameter M",
          "type": "number"
        },
        "valve_mass_g": {
          "default": 34.0,
          "exclusiveMinimum": 0.0,
          "title": "Valve Mass G",
          "type": "number"
        },
        "minimum_hole_factor": {
          "default": 5.0,
          "exclusiveMinimum": 0.0,
          "title": "Minimum Hole Factor",
          "type": "number"
        },
        "minimum_design_hole_factor": {
          "default": 8.0,
          "exclusiveMinimum": 0.0,
          "title": "Minimum Design Hole Factor",
          "type": "number"
        },
        "maximum_hole_factor": {
          "default": 12.0,
          "exclusiveMinimum": 0.0,
          "title": "Maximum Hole Factor",
          "type": "number"
        },
        "aeration_factor": {
          "default": 0.5,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Aeration Factor",
          "type": "number"
        },
        "edge_clearance_m": {
          "default": 0.05,
          "exclusiveMinimum": 0.0,
          "title": "Edge Clearance M",
          "type": "number"
        },
        "disengagement_strip_m": {
          "default": 0.075,
          "minimum": 0.0,
          "title": "Disengagement Strip M",
          "type": "number"
        },
        "minimum_pitch_m": {
          "default": 0.075,
          "exclusiveMinimum": 0.0,
          "title": "Minimum Pitch M",
          "type": "number"
        },
        "maximum_pitch_m": {
          "default": 0.15,
          "exclusiveMinimum": 0.0,
          "title": "Maximum Pitch M",
          "type": "number"
        },
        "minimum_weir_crest_m": {
          "default": 0.006,
          "exclusiveMinimum": 0.0,
          "title": "Minimum Weir Crest M",
          "type": "number"
        },
        "minimum_downcomer_residence_s": {
          "default": 5.0,
          "minimum": 3.0,
          "title": "Minimum Downcomer Residence S",
          "type": "number"
        },
        "francis_E": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 1.2,
          "title": "Francis E",
          "type": "number"
        },
        "entrainment_capacity_m_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entrainment Capacity M S"
        },
        "entrainment_source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entrainment Source Id"
        },
        "entrainment_max_index": {
          "default": 0.8,
          "exclusiveMinimum": 0.0,
          "maximum": 0.8,
          "title": "Entrainment Max Index",
          "type": "number"
        },
        "property_factor": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Property Factor",
          "type": "number"
        }
      },
      "title": "F1ValveBasis",
      "type": "object"
    },
    "Feed": {
      "additionalProperties": false,
      "properties": {
        "flow": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flow"
        },
        "flow_unit": {
          "anyOf": [
            {
              "enum": [
                "kmol/h",
                "mol/s"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flow Unit"
        },
        "composition": {
          "items": {
            "type": "number"
          },
          "title": "Composition",
          "type": "array"
        },
        "composition_basis": {
          "anyOf": [
            {
              "enum": [
                "mole_fraction",
                "mass_fraction"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Composition Basis"
        },
        "temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature K"
        },
        "pressure_kPa": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pressure Kpa"
        },
        "quality_q": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Q"
        }
      },
      "title": "Feed",
      "type": "object"
    },
    "ProcessDesignBasis": {
      "additionalProperties": false,
      "properties": {
        "design_id": {
          "title": "Design Id",
          "type": "string"
        },
        "process_family": {
          "enum": [
            "binary_distillation",
            "liquid_liquid_extraction",
            "extraction_distillation"
          ],
          "title": "Process Family",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "title": "Components",
          "type": "array"
        },
        "streams": {
          "items": {
            "$ref": "#/$defs/ProcessStream"
          },
          "title": "Streams",
          "type": "array"
        },
        "feed_stream_id": {
          "default": "feed",
          "title": "Feed Stream Id",
          "type": "string"
        },
        "solvent_component_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solvent Component Id"
        },
        "carrier_component_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Carrier Component Id"
        },
        "solute_component_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solute Component Id"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/ProcessTarget"
          },
          "title": "Targets",
          "type": "array"
        },
        "thermodynamic_model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thermodynamic Model Id"
        },
        "extraction_temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraction Temperature K"
        },
        "extraction_pressure_Pa": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraction Pressure Pa"
        },
        "search": {
          "$ref": "#/$defs/ExtractionSearch"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "unresolved_source_findings": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Source Findings",
          "type": "array"
        },
        "legacy_binary_basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/DesignBasis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "process_family"
      ],
      "title": "ProcessDesignBasis",
      "type": "object"
    },
    "ProcessStream": {
      "additionalProperties": false,
      "properties": {
        "stream_id": {
          "minLength": 1,
          "title": "Stream Id",
          "type": "string"
        },
        "flow": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flow"
        },
        "flow_unit": {
          "anyOf": [
            {
              "enum": [
                "kg/h",
                "kmol/h"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flow Unit"
        },
        "composition": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Composition",
          "type": "object"
        },
        "composition_basis": {
          "anyOf": [
            {
              "enum": [
                "mole_fraction",
                "mass_fraction"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Composition Basis"
        },
        "temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature K"
        },
        "pressure_Pa": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pressure Pa"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "stream_id"
      ],
      "title": "ProcessStream",
      "type": "object"
    },
    "ProcessTarget": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "component_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component Id"
        },
        "component_ids": {
          "items": {
            "type": "string"
          },
          "title": "Component Ids",
          "type": "array"
        },
        "quantity": {
          "enum": [
            "mass_fraction",
            "mole_fraction",
            "recovery",
            "concentration_mg_L",
            "purity_basis_unresolved"
          ],
          "title": "Quantity",
          "type": "string"
        },
        "operator": {
          "enum": [
            ">=",
            "<=",
            ">",
            "<"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0.0,
          "title": "Value",
          "type": "number"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "target_id",
        "location",
        "quantity",
        "operator",
        "value"
      ],
      "title": "ProcessTarget",
      "type": "object"
    },
    "PumpBasis": {
      "additionalProperties": false,
      "properties": {
        "storage_temperature_K": {
          "default": 293.15,
          "maximum": 350.0,
          "minimum": 273.16,
          "title": "Storage Temperature K",
          "type": "number"
        },
        "storage_pressure_Pa": {
          "default": 101325.0,
          "exclusiveMinimum": 0.0,
          "title": "Storage Pressure Pa",
          "type": "number"
        },
        "storage_liquid_level_above_pump_m": {
          "default": 2.0,
          "title": "Storage Liquid Level Above Pump M",
          "type": "number"
        },
        "suction_length_m": {
          "default": 5.0,
          "minimum": 0.0,
          "title": "Suction Length M",
