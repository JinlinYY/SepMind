{
  "$defs": {
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "input_specification",
            "property_database",
            "solver_run",
            "source_reported"
          ],
          "title": "Type",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "valid_temperature_K": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Temperature K"
        }
      },
      "required": [
        "evidence_id",
        "type",
        "source"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "code",
        "explanation"
      ],
      "title": "Reason",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "success",
        "needs_input",
        "unsupported",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "tool_name": {
      "title": "Tool Name",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "units": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Units",
      "type": "object"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Evidence",
      "type": "array"
    },
    "diagnostics": {
      "additionalProperties": true,
      "title": "Diagnostics",
      "type": "object"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/Reason"
      },
      "title": "Errors",
      "type": "array"
    },
    "source_or_run": {
      "title": "Source Or Run",
      "type": "string"
    },
    "convergence": {
      "additionalProperties": true,
      "title": "Convergence",
      "type": "object"
    },
    "validation": {
      "additionalProperties": true,
      "title": "Validation",
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "error_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Type"
    }
  },
  "required": [
    "status",
    "tool_name",
    "run_id",
    "source_or_run"
  ],
  "title": "ToolResult",
  "type": "object"
}